{
  "$schema": "https://opencode.ai/config.json",
  "model": "aiverde/js2/gpt-oss-120b",
  "provider": {
    "aiverde": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CyVerse AI Verde",
      "options": {
        "baseURL": "https://llm-api.cyverse.ai/v1",
        "apiKey": "{env:LLM_API_KEY}"
      },
      "models": {
        "js2/gpt-oss-120b": { "name": "gpt-oss-120b (Jetstream2)" },
        "nrp/gpt-oss": { "name": "gpt-oss (NRP)" },
        "nrp/glm-5": { "name": "GLM-5 (NRP)" },
        "nrp/glm-4.7": { "name": "GLM-4.7 (NRP)" },
        "nrp/qwen3": { "name": "Qwen3 (NRP)" },
        "nrp/qwen3-small": { "name": "Qwen3 small (NRP)" },
        "nrp/kimi": { "name": "Kimi (NRP)" },
        "nrp/gemma": { "name": "Gemma (NRP)" },
        "nrp/minimax-m2": { "name": "MiniMax-M2 (NRP)" },
        "phi-4-multimodal-instruct": { "name": "Phi-4 multimodal" }
      }
    }
  },
  "mcp": {
    "irods": {
      "type": "local",
      "command": ["/usr/local/bin/irods-mcp-server"],
      "enabled": true,
      "environment": {
        "IRODS_HOST": "data.cyverse.org",
        "IRODS_PORT": "1247",
        "IRODS_ZONE_NAME": "iplant",
        "IRODS_MCP_SVR_IRODS_SHARED_DIR_NAME": "shared"
      }
    },
    "mesa": {
      "type": "local",
      "command": ["/usr/local/bin/mesa-mcp"],
      "enabled": true,
      "environment": {
        "MESA_MCP_IRODS__HOST": "data.cyverse.org",
        "MESA_MCP_IRODS__PORT": "1247",
        "MESA_MCP_IRODS__ZONE": "iplant"
      }
    },
    "formation": {
      "type": "local",
      "command": ["/usr/local/bin/formation-mcp"],
      "enabled": true,
      "environment": {
        "FORMATION_BASE_URL": "https://de.cyverse.org/formation"
      }
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/home/jovyan/work", "/home/jovyan/data-store"],
      "enabled": true
    }
  }
}
